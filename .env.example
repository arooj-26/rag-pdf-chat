# Copy to .env; never commit real credentials.
APP_NAME=AI Research & Study Assistant
APP_ENV=development
DEBUG=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DATABASE_URL=sqlite:///./data/pdf_chat.db
# Local server (docker compose up -d qdrant), or set QDRANT_PATH=./data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
QDRANT_API_KEY=
QDRANT_COLLECTION=research_chunks
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATES=20
RRF_CONSTANT=60
# Optional lexical overlap reranker, not a neural cross-encoder
RERANK_ENABLED=false
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=300
MAX_EXTRACTED_CHARACTERS=2000000
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT=30
REQUESTS_PER_MINUTE=60
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-in-production
COOKIE_SECURE=false
SESSION_HOURS=24
ALLOWED_ORIGINS=[]
OCR_ENABLED=false
OCR_LANGUAGE=eng
MAX_HISTORY_MESSAGES=12
# Disable document-bearing remote traces by default.
LANGCHAIN_TRACING_V2=false
